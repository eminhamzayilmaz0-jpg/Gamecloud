<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Firebase yedekleme için gerekli -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Android 11+ paket görünürlüğü: sadece başlatılabilir uygulamaları görmek için
         (QUERY_ALL_PACKAGES yerine, Play Store politikasına uygun) -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <application
        android:name=".GameCloudApplication"
        android:theme="@style/Theme.GameCloud"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="GameCloud"
        android:allowBackup="true"
        android:supportsRtl="true">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
        </activity>
    </application>
</manifest>
